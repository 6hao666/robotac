@startuml
!theme plain
skinparam backgroundColor #F4F6F8
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif
skinparam ArrowColor #4B5563
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #24528C
left to right direction
title 舵机安全标定流程
rectangle "断开飞行动力、拆桨\n卸下传动附件" as isolate
rectangle "检查供电、设备、限位\n与断电手段" as inspect
rectangle "裸舵机\n小步点动" as jog
rectangle "转向与范围\n正常?" as directionGate
rectangle "断电并\n重新安装机构" as reinstall
rectangle "标定 blocked_angle\n与 released_angle" as calibrate
rectangle "独立 SetBool\n服务检查" as service
rectangle "无卡滞、顶死\n或压降?" as loadGate
rectangle "拆桨带载\n台架检查" as bench
rectangle "断电排查机械、\n供电与参数" as repair
isolate --> inspect
inspect --> jog
jog --> directionGate
directionGate --> reinstall : 是
reinstall --> calibrate
calibrate --> service
service --> loadGate
loadGate --> bench : 是
directionGate -down-> repair : 否
loadGate -down-> repair : 否
@enduml
