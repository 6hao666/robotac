<launch>
  <arg name="config_root" default="$(env HOME)/robotac_ws/config" />
  <arg name="fcu_url" default="serial:///dev/ttyACM0:921600" />
  <arg name="video_device" default="/dev/robotac_rgb_camera" />
  <arg name="tags_config" default="$(arg config_root)/apriltag/tags.yaml" />
  <arg name="use_config_tags" default="true" />
  <arg name="tag_id" default="0" />
  <arg name="tag_size" default="0.15" />
  <arg name="rviz" default="false" />
  <!-- MAVROS is opt-in so sensor and SLAM bench tests never open the FCU link. -->
  <arg name="enable_mavros" default="false" />
  <arg name="vision_bridge_type" default="path_a" />
  <arg name="vision_input_topic" default="/sunray/odometry" />
  <arg name="vision_output_topic" default="/mavros/vision_pose/pose" />
  <arg name="vision_output_type" default="pose" />
  <arg name="vision_output_parent" default="odom" />
  <arg name="enable_vision_bridge" default="false" />
  <arg name="vision_enable_output" default="false" />
  <arg name="enable_flight_controller" default="false" />
  <arg name="flight_enable_control" default="false" />
  <arg name="flight_auto_mode" default="false" />
  <arg name="flight_auto_arm" default="false" />
  <arg name="flight_auto_land" default="false" />
  <arg name="flight_enable_payload" default="false" />
  <arg name="flight_route_file" default="$(arg config_root)/flight/local_waypoints.yaml" />
  <arg name="flight_setpoint_topic" default="/mavros/setpoint_raw/local" />
  <arg name="flight_require_setpoint_consumer" default="true" />
  <arg name="flight_setpoint_consumer_node" default="/mavros" />
  <!-- Servo hardware is independent and never starts unless explicitly asked. -->
  <arg name="enable_servo" default="false" />
  <arg name="servo_port" default="/dev/ttyUSB0" />
  <arg name="servo_open_angle" default="45" />
  <arg name="servo_close_on_shutdown" default="true" />
  <!-- Telemetry is passive; PX4 output/control requires an explicitly requested FCU connection. -->
  <arg name="require_fcu" default="$(eval (arg('enable_vision_bridge') == 'true' and arg('vision_enable_output') == 'true') or (arg('enable_flight_controller') == 'true' and arg('flight_enable_control') == 'true'))" />
  <arg name="require_flight" default="$(eval arg('enable_flight_controller') == 'true' and arg('flight_enable_control') == 'true')" />
  <arg name="require_vision_output" default="$(eval arg('enable_vision_bridge') == 'true' and arg('vision_enable_output') == 'true')" />
  <arg name="require_payload" default="$(eval arg('enable_servo') == 'true' or (arg('enable_flight_controller') == 'true' and arg('flight_enable_payload') == 'true'))" />
  <!-- Camera/LiDAR calibration gates apply only when their data leaves the passive stack. -->
  <arg name="require_sensor_calibration" default="$(eval (arg('enable_vision_bridge') == 'true' and arg('vision_enable_output') == 'true') or (arg('enable_flight_controller') == 'true' and arg('flight_enable_control') == 'true'))" />

  <node pkg="robotac_bringup" type="check_hardware_config.sh"
        name="check_hardware_config" args="--hold $(arg config_root) $(arg require_fcu) $(arg require_flight) $(arg require_vision_output) $(arg require_payload) $(arg enable_mavros) $(arg require_sensor_calibration)"
        output="screen" required="true" />

  <group if="$(arg enable_mavros)">
    <include file="$(find robotac_bringup)/launch/mavros_px4.launch">
      <arg name="config_root" value="$(arg config_root)" />
      <arg name="fcu_url" value="$(arg fcu_url)" />
    </include>
  </group>
  <include file="$(find robotac_bringup)/launch/lidar_mid360s.launch">
    <arg name="config_root" value="$(arg config_root)" />
  </include>
  <include file="$(find robotac_bringup)/launch/camera_rgb.launch">
    <arg name="config_root" value="$(arg config_root)" />
    <arg name="video_device" value="$(arg video_device)" />
  </include>
  <include file="$(find robotac_bringup)/launch/fastlio_mid360s.launch">
    <arg name="config_root" value="$(arg config_root)" />
    <arg name="rviz" value="$(arg rviz)" />
  </include>
  <include file="$(find robotac_bringup)/launch/apriltag_rgb.launch">
    <arg name="config_root" value="$(arg config_root)" />
    <arg name="tags_config" value="$(arg tags_config)" />
    <arg name="use_config_tags" value="$(arg use_config_tags)" />
    <arg name="tag_id" value="$(arg tag_id)" />
    <arg name="tag_size" value="$(arg tag_size)" />
  </include>
  <group if="$(arg enable_servo)">
    <include file="$(find robotac_servo)/launch/servo.launch">
      <arg name="port" value="$(arg servo_port)" />
      <arg name="open_angle" value="$(arg servo_open_angle)" />
      <arg name="initial_open" value="false" />
      <arg name="close_on_shutdown" value="$(arg servo_close_on_shutdown)" />
    </include>
  </group>
  <group if="$(arg enable_vision_bridge)">
    <group if="$(eval arg('vision_bridge_type') == 'path_a')">
      <include file="$(find robotac_flight)/launch/path_a_vision_pose.launch">
        <arg name="config_root" value="$(arg config_root)" />
        <arg name="input_topic" value="$(arg vision_input_topic)" />
        <arg name="output_topic" value="$(arg vision_output_topic)" />
        <arg name="enable_mavros_output" value="$(arg vision_enable_output)" />
      </include>
    </group>
    <group if="$(eval arg('vision_bridge_type') == 'pose_cov')">
      <include file="$(find robotac_flight)/launch/fastlio_vision_bridge.launch">
        <arg name="config_root" value="$(arg config_root)" />
        <arg name="input_topic" value="$(arg vision_input_topic)" />
        <arg name="output_topic" value="$(arg vision_output_topic)" />
        <arg name="enable_mavros_output" value="$(arg vision_enable_output)" />
      </include>
    </group>
  </group>
  <group if="$(arg enable_flight_controller)">
    <include file="$(find robotac_flight)/launch/local_waypoint_flight.launch">
      <arg name="config_root" value="$(arg config_root)" />
      <arg name="route_file" value="$(arg flight_route_file)" />
      <arg name="enable_control" value="$(arg flight_enable_control)" />
      <arg name="auto_mode" value="$(arg flight_auto_mode)" />
      <arg name="auto_arm" value="$(arg flight_auto_arm)" />
      <arg name="auto_land" value="$(arg flight_auto_land)" />
      <arg name="enable_payload" value="$(arg flight_enable_payload)" />
      <arg name="setpoint_topic" value="$(arg flight_setpoint_topic)" />
      <arg name="require_setpoint_consumer" value="$(arg flight_require_setpoint_consumer)" />
      <arg name="setpoint_consumer_node" value="$(arg flight_setpoint_consumer_node)" />
      <arg name="vision_output_topic" value="$(arg vision_output_topic)" />
      <arg name="vision_output_type" value="$(arg vision_output_type)" />
      <arg name="vision_output_parent" value="$(arg vision_output_parent)" />
    </include>
  </group>
</launch>
