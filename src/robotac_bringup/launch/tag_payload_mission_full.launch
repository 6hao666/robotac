<launch>
  <!--
    Full AprilTag payload mission stack.

    Safe default: live_flight=false starts sensors, AprilTag, and the mission
    node in preview/passive mode only.  For a real field run, pass
    live_flight:=true and then explicitly call:

      rosservice call /robotac/tag_payload_mission/start "{}"

    The mission frame captured by that service is +x nose/front, +y aircraft
    right, +z up.
  -->
  <arg name="config_root" default="$(env HOME)/robotac_ws/config" />
  <arg name="mission_file" default="$(arg config_root)/flight/tag_payload_mission.yaml" />
  <arg name="fcu_url" default="serial:///dev/ttyACM0:921600" />
  <arg name="video_device" default="/dev/robotac_rgb_camera" />
  <arg name="servo_port" default="/dev/ttyUSB0" />
  <arg name="tags_config" default="$(arg config_root)/apriltag/tags.yaml" />
  <arg name="live_flight" default="false" />
  <arg name="rviz" default="false" />
  <!-- AprilTag-guided flight needs a valid TF chain from local/map to the
       camera optical frame. Keep this off by default so a zero placeholder
       transform is never published accidentally on the aircraft. -->
  <arg name="camera_extrinsics_enabled" default="false" />
  <arg name="camera_extrinsics_parent" default="base_link" />
  <arg name="camera_extrinsics_child" default="camera_rgb_optical_frame" />
  <arg name="camera_x" default="0.0" />
  <arg name="camera_y" default="0.0" />
  <arg name="camera_z" default="0.0" />
  <arg name="camera_roll" default="0.0" />
  <arg name="camera_pitch" default="0.0" />
  <arg name="camera_yaw" default="0.0" />

  <include file="$(find robotac_bringup)/launch/full_system.launch">
    <arg name="config_root" value="$(arg config_root)" />
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="video_device" value="$(arg video_device)" />
    <arg name="tags_config" value="$(arg tags_config)" />
    <arg name="rviz" value="$(arg rviz)" />

    <!-- The dedicated mission node below owns the waypoint state machine. -->
    <arg name="enable_flight_controller" value="false" />

    <!-- External vision and MAVROS are enabled only for a deliberate live run. -->
    <arg name="enable_mavros" value="$(arg live_flight)" />
    <arg name="enable_vision_bridge" value="$(arg live_flight)" />
    <arg name="vision_enable_output" value="$(arg live_flight)" />

    <!-- Servo starts closed, and only this mission node opens it at tag ID 1. -->
    <arg name="enable_servo" value="$(arg live_flight)" />
    <arg name="servo_port" value="$(arg servo_port)" />
    <arg name="servo_open_angle" value="45" />
    <arg name="servo_close_on_shutdown" value="true" />
  </include>

  <include file="$(find robotac_flight)/launch/tag_payload_mission.launch">
    <arg name="config_root" value="$(arg config_root)" />
    <arg name="mission_file" value="$(arg mission_file)" />
    <arg name="enable_control" value="$(arg live_flight)" />
    <arg name="auto_mode" value="$(arg live_flight)" />
    <arg name="auto_arm" value="$(arg live_flight)" />
    <arg name="auto_land" value="$(arg live_flight)" />
    <arg name="enable_payload" value="$(arg live_flight)" />
  </include>

  <group if="$(arg camera_extrinsics_enabled)">
    <include file="$(find robotac_bringup)/launch/camera_extrinsics.launch">
      <arg name="parent_frame" value="$(arg camera_extrinsics_parent)" />
      <arg name="child_frame" value="$(arg camera_extrinsics_child)" />
      <arg name="x" value="$(arg camera_x)" />
      <arg name="y" value="$(arg camera_y)" />
      <arg name="z" value="$(arg camera_z)" />
      <arg name="roll" value="$(arg camera_roll)" />
      <arg name="pitch" value="$(arg camera_pitch)" />
      <arg name="yaw" value="$(arg camera_yaw)" />
    </include>
  </group>
</launch>
