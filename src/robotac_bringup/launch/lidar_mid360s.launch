<launch>
  <arg name="config_root" default="$(env HOME)/robotac_ws/config" />
  <arg name="lidar_config" default="$(arg config_root)/lidar/mid360s.json" />
  <arg name="bd_list" default="100000000000000" />
  <arg name="frame_id" default="livox_frame" />
  <arg name="publish_freq" default="10.0" />
  <arg name="lidar_bag" default="false" />
  <arg name="imu_bag" default="false" />

  <param name="xfer_format" value="1" />
  <param name="multi_topic" value="0" />
  <param name="data_src" value="0" />
  <param name="publish_freq" type="double" value="$(arg publish_freq)" />
  <param name="output_data_type" value="0" />
  <param name="cmdline_str" type="string" value="$(arg bd_list)" />
  <param name="user_config_path" type="string" value="$(arg lidar_config)" />
  <param name="frame_id" type="string" value="$(arg frame_id)" />
  <param name="enable_lidar_bag" type="bool" value="$(arg lidar_bag)" />
  <param name="enable_imu_bag" type="bool" value="$(arg imu_bag)" />

  <node pkg="livox_ros_driver2" type="livox_ros_driver2_node"
        name="livox_lidar_publisher" required="true" output="screen"
        args="$(arg bd_list)" />
</launch>
