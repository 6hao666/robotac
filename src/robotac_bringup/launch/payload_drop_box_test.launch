<launch>
  <!--
    Payload drop-box test entry point.

    Safe default: live_flight=false starts the stack without FCU control output,
    auto mode changes, arming, landing requests, or servo commands. For the real
    field test use live_flight:=true, then still call /robotac/flight/start
    explicitly after final human checks.
  -->
  <arg name="config_root" default="$(env HOME)/robotac_ws/config" />
  <arg name="route_file" default="$(arg config_root)/flight/payload_drop_box_test.yaml" />
  <arg name="live_flight" default="false" />
  <arg name="fcu_url" default="serial:///dev/ttyACM0:921600" />
  <arg name="video_device" default="/dev/robotac_rgb_camera" />
  <arg name="servo_port" default="/dev/robotac_servo" />
  <arg name="rviz" default="false" />

  <include file="$(find robotac_bringup)/launch/full_system.launch">
    <arg name="config_root" value="$(arg config_root)" />
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="video_device" value="$(arg video_device)" />
    <arg name="rviz" value="$(arg rviz)" />

    <!-- Path A: /sunray/odometry -> /mavros/vision_pose/pose. -->
    <arg name="vision_bridge_type" value="path_a" />
    <arg name="vision_input_topic" value="/sunray/odometry" />
    <arg name="vision_output_topic" value="/mavros/vision_pose/pose" />
    <arg name="vision_output_type" value="pose" />
    <arg name="vision_output_parent" value="odom" />

    <!-- Sensors and the flight node are launched; FCU-bound outputs stay gated
         unless live_flight:=true is passed explicitly. -->
    <arg name="enable_mavros" value="$(arg live_flight)" />
    <arg name="enable_vision_bridge" value="true" />
    <arg name="vision_enable_output" value="$(arg live_flight)" />
    <arg name="enable_flight_controller" value="true" />
    <arg name="flight_route_file" value="$(arg route_file)" />
    <arg name="flight_enable_control" value="$(arg live_flight)" />
    <arg name="flight_auto_mode" value="$(arg live_flight)" />
    <arg name="flight_auto_arm" value="$(arg live_flight)" />
    <arg name="flight_auto_land" value="$(arg live_flight)" />

    <!-- Servo is only opened by the flight route at the rear waypoint. It is
         started closed for live flight and closed again on shutdown. -->
    <arg name="enable_servo" value="$(arg live_flight)" />
    <arg name="servo_port" value="$(arg servo_port)" />
    <arg name="servo_open_angle" value="45" />
    <arg name="servo_close_on_shutdown" value="true" />
    <arg name="flight_enable_payload" value="$(arg live_flight)" />
  </include>
</launch>
