<launch>
  <!-- Read-only FAST-LIO preview frame-alignment observer. This launch starts
       only fastlio_frame_alignment_observer.py; it never publishes topics,
       calls MAVROS services, changes PX4 parameters, arms, requests modes, or
       sends setpoints. Keep enable_mavros_output:=false on the vision bridge
       while collecting this evidence. -->
  <arg name="observe_seconds" default="20.0" />
  <arg name="startup_timeout" default="30.0" />
  <arg name="stream_timeout" default="0.75" />
  <arg name="age_limit" default="0.50" />
  <arg name="future_tolerance" default="0.10" />
  <arg name="min_samples" default="20" />
  <arg name="min_rate_hz" default="5.0" />
  <arg name="motion_type" default="translation" />
  <arg name="motion_name" default="manual_axis_check" />
  <arg name="expected_x" default="1.0" />
  <arg name="expected_y" default="0.0" />
  <arg name="expected_z" default="0.0" />
  <arg name="expected_distance_m" default="0.0" />
  <arg name="min_translation_m" default="0.30" />
  <arg name="max_direction_error_deg" default="25.0" />
  <arg name="min_delta_scale" default="0.50" />
  <arg name="max_delta_scale" default="2.00" />
  <arg name="expected_yaw_deg" default="0.0" />
  <arg name="expected_yaw_sign" default="0" />
  <arg name="min_yaw_deg" default="20.0" />
  <arg name="max_yaw_error_deg" default="25.0" />
  <arg name="require_vision_status_ok" default="true" />
  <arg name="require_mavros_output_disabled" default="true" />
  <arg name="expected_parent" default="odom" />
  <arg name="pose_topic" default="/robotac/fastlio_vision/path_a_pose_preview" />
  <arg name="pose_type" default="pose" />
  <arg name="vision_status_topic" default="/robotac/fastlio_vision/status" />
  <arg name="vision_output_enabled_topic" default="/robotac/fastlio_vision/output_enabled" />
  <arg name="evidence_file" default="" />

  <node pkg="robotac_flight" type="fastlio_frame_alignment_observer.py"
        name="fastlio_frame_alignment_observer" output="screen" required="true">
    <param name="observe_seconds" value="$(arg observe_seconds)" />
    <param name="startup_timeout" value="$(arg startup_timeout)" />
    <param name="stream_timeout" value="$(arg stream_timeout)" />
    <param name="age_limit" value="$(arg age_limit)" />
    <param name="future_tolerance" value="$(arg future_tolerance)" />
    <param name="min_samples" value="$(arg min_samples)" />
    <param name="min_rate_hz" value="$(arg min_rate_hz)" />
    <param name="motion_type" value="$(arg motion_type)" />
    <param name="motion_name" value="$(arg motion_name)" />
    <param name="expected_x" value="$(arg expected_x)" />
    <param name="expected_y" value="$(arg expected_y)" />
    <param name="expected_z" value="$(arg expected_z)" />
    <param name="expected_distance_m" value="$(arg expected_distance_m)" />
    <param name="min_translation_m" value="$(arg min_translation_m)" />
    <param name="max_direction_error_deg" value="$(arg max_direction_error_deg)" />
    <param name="min_delta_scale" value="$(arg min_delta_scale)" />
    <param name="max_delta_scale" value="$(arg max_delta_scale)" />
    <param name="expected_yaw_deg" value="$(arg expected_yaw_deg)" />
    <param name="expected_yaw_sign" value="$(arg expected_yaw_sign)" />
    <param name="min_yaw_deg" value="$(arg min_yaw_deg)" />
    <param name="max_yaw_error_deg" value="$(arg max_yaw_error_deg)" />
    <param name="require_vision_status_ok" value="$(arg require_vision_status_ok)" />
    <param name="require_mavros_output_disabled" value="$(arg require_mavros_output_disabled)" />
    <param name="expected_parent" value="$(arg expected_parent)" />
    <param name="pose_topic" value="$(arg pose_topic)" />
    <param name="pose_type" value="$(arg pose_type)" />
    <param name="vision_status_topic" value="$(arg vision_status_topic)" />
    <param name="vision_output_enabled_topic" value="$(arg vision_output_enabled_topic)" />
    <param name="evidence_file" value="$(arg evidence_file)" />
  </node>
</launch>
