<launch>
  <!-- Read-only PX4/MAVROS external-vision acceptance observer. This launch
       starts only ev_acceptance_observer.py; it never publishes setpoints,
       calls flight services, changes PX4 parameters, or opens serial ports. -->
  <arg name="observe_seconds" default="20.0" />
  <arg name="startup_timeout" default="60.0" />
  <arg name="stream_timeout" default="0.75" />
  <arg name="age_limit" default="0.50" />
  <arg name="future_tolerance" default="0.10" />
  <arg name="min_samples" default="20" />
  <arg name="min_rate_hz" default="5.0" />
  <arg name="min_motion_m" default="0.30" />
  <arg name="max_direction_error_deg" default="25.0" />
  <arg name="min_delta_scale" default="0.50" />
  <arg name="max_delta_scale" default="2.00" />
  <arg name="require_connected" default="true" />
  <arg name="require_disarmed" default="true" />
  <arg name="require_on_ground" default="true" />
  <arg name="require_vision_output_enabled" default="true" />
  <arg name="require_vision_status_ok" default="true" />
  <arg name="evidence_file" default="" />
  <arg name="local_parent" default="map" />
  <arg name="local_child" default="base_link" />
  <arg name="vision_parent" default="odom" />
  <arg name="state_topic" default="/mavros/state" />
  <arg name="extended_state_topic" default="/mavros/extended_state" />
  <arg name="local_topic" default="/mavros/local_position/odom" />
  <arg name="vision_topic" default="/mavros/vision_pose/pose_cov" />
  <arg name="vision_output_enabled_topic" default="/robotac/fastlio_vision/output_enabled" />
  <arg name="vision_status_topic" default="/robotac/fastlio_vision/status" />

  <node pkg="robotac_flight" type="ev_acceptance_observer.py"
        name="ev_acceptance_observer" output="screen" required="true">
    <param name="observe_seconds" value="$(arg observe_seconds)" />
    <param name="startup_timeout" value="$(arg startup_timeout)" />
    <param name="stream_timeout" value="$(arg stream_timeout)" />
    <param name="age_limit" value="$(arg age_limit)" />
    <param name="future_tolerance" value="$(arg future_tolerance)" />
    <param name="min_samples" value="$(arg min_samples)" />
    <param name="min_rate_hz" value="$(arg min_rate_hz)" />
    <param name="min_motion_m" value="$(arg min_motion_m)" />
    <param name="max_direction_error_deg" value="$(arg max_direction_error_deg)" />
    <param name="min_delta_scale" value="$(arg min_delta_scale)" />
    <param name="max_delta_scale" value="$(arg max_delta_scale)" />
    <param name="require_connected" value="$(arg require_connected)" />
    <param name="require_disarmed" value="$(arg require_disarmed)" />
    <param name="require_on_ground" value="$(arg require_on_ground)" />
    <param name="require_vision_output_enabled" value="$(arg require_vision_output_enabled)" />
    <param name="require_vision_status_ok" value="$(arg require_vision_status_ok)" />
    <param name="evidence_file" value="$(arg evidence_file)" />
    <param name="local_parent" value="$(arg local_parent)" />
    <param name="local_child" value="$(arg local_child)" />
    <param name="vision_parent" value="$(arg vision_parent)" />
    <param name="state_topic" value="$(arg state_topic)" />
    <param name="extended_state_topic" value="$(arg extended_state_topic)" />
    <param name="local_topic" value="$(arg local_topic)" />
    <param name="vision_topic" value="$(arg vision_topic)" />
    <param name="vision_output_enabled_topic" value="$(arg vision_output_enabled_topic)" />
    <param name="vision_status_topic" value="$(arg vision_status_topic)" />
  </node>
</launch>
