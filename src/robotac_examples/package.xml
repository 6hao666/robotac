<?xml version="1.0"?>
<package format="2">
  <name>robotac_examples</name>
  <version>0.1.0</version>
  <description>面向 Robotac 参赛选手的无人机控制与感知教学示例。</description>
  <maintainer email="liyihan.xyz@gmail.com">Li Yihan</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>apriltag_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robotac_servo</exec_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>
</package>
